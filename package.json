{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "turbo run generate",
    "generate:operations": "node apps/backend/scripts/generate-operation-allowlist.mjs",
    "check:operations": "node apps/backend/scripts/generate-operation-allowlist.mjs --check",
    "check:migrations": "node scripts/check-migrations-synced.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "start": "turbo run start",
    "format": "prettier --write \"**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,scss}\"",
    "check": "npm run check:operations && npm run check:migrations && npm run format:check && npm run type-check && npm run lint && npm run test",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260301.1",
    "@playwright/test": "^1.58.2",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/node": "^25.2.1",
    "baseline-browser-mapping": "^2.10.42",
    "patch-package": "8.0.1",
    "prettier": "3.6.2",
    "turbo": "2.5.8"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "4.52.4",
    "@rollup/rollup-linux-x64-gnu": "4.52.4",
    "@rollup/rollup-linux-x64-musl": "4.52.4"
  },
  "name": "berkeleytime"
}
